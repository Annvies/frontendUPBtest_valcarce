# Frontend environment variables
#
# Next.js carga los archivos en este orden (gana el primero que define la variable):
#   1. .env.$(NODE_ENV).local
#   2. .env.local          (ignorado en git — NO usar para producción)
#   3. .env.$(NODE_ENV)
#   4. .env
#
# En este proyecto:
#   - `npm run dev`   (development) -> .env.development
#   - `npm run build` (production)  -> .env.production

# Desarrollo local (.env.development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Producción / Firebase Hosting (.env.production)
# NEXT_PUBLIC_API_URL=https://backendupbtest-valcarce.onrender.com
